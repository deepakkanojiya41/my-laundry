rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function owner() {
      return request.auth != null
        && request.auth.token.email == 'deepakkanojiya41@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email; }
    /* a customer may only touch a document that carries their own email */
    function mine() { return signedIn() && request.resource.data.email == myEmail(); }
    function mineExisting() { return signedIn() && resource.data.email == myEmail(); }

    match /settings/{doc} { allow read: if signedIn(); allow write: if owner(); }
    match /meta/{doc}     { allow read: if signedIn(); allow write: if owner(); }

    match /customers/{id} {
      allow read: if owner() || mineExisting();
      allow create: if owner() || mine();
      allow update: if owner() || (mineExisting() && request.resource.data.email == resource.data.email);
      allow delete: if owner();
    }

    match /entries/{id} {
      allow read: if owner() || (signedIn() && resource.data.customerEmail == myEmail());
      allow write: if owner();
    }

    match /requests/{id} {
      allow read: if owner() || (signedIn() && resource.data.customerEmail == myEmail());
      allow create: if signedIn();
      allow update, delete: if owner();
    }

    match /app/{doc} { allow read, write: if owner(); }

    match /{document=**} { allow read, write: if false; }
  }
}
